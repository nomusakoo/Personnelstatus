# @BotFather에게 /newbot으로 발급받은 텔레그램 봇 토큰
TELEGRAM_BOT_TOKEN=

# 웹앱(index.html)이 사용하는 것과 동일한 Supabase 프로젝트
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ⚠ anon key가 아니라 service_role 키 (Project Settings → API → service_role)
# 이 키는 RLS를 우회하므로 절대 다른 곳에 공유하거나 커밋하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 이 봇을 사용할 수 있는 텔레그램 숫자 사용자 ID (콤마로 구분)
# 본인의 ID는 텔레그램에서 @userinfobot에게 아무 메시지나 보내면 확인 가능
ALLOWED_TELEGRAM_IDS=111111111,222222222

# (선택) 외부 연동 임원일정 — 웹앱의 "🔗 외부 임원 일정 연동"과 동일하게,
# 별도 Supabase 프로젝트의 hr_exec_events 테이블을 함께 조회해 "임원일정"에 합쳐 보여준다.
# 둘 다 채워야 활성화되며, 비워두면 기존처럼 기본 임원일정만 표시된다.
SUPABASE2_URL=
SUPABASE2_SERVICE_ROLE_KEY=
